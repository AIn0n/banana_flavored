use { Iterable, Maybe, invalid } from typing;
use { Pool } from memory;


// some way of auto init?
struct LinkedListNode[T] {
    elem: T;
    next: Maybe[&LinkedListNode[T]];

    new(@, el: T) {
        @.elem = el;
        @.next = invalid[&LinkedListNode[T]]();
    }
}

struct LinkedList[T] : Iterable {
    head: Maybe[LinkedListNode[T]];

    new(@) {
        @.head = invalid[LinkedListNode[T]]();
    }

    tail(@) -> Maybe[&LinkedListNode[T]] {
        tmp: Maybe[&LinkedListNode[T]] = @head;
        while (tmp.next.is_valid?()) {
            tmp = tmp.next;
        }
        return tmp;
    }

    append(@, alloc: Pool[LinkedListNode[T]], el: T) -> bool {
        new_elem_node : Maybe[LinkedListNode[T]] = alloc(el);
        if (new_elem_node.is_invalid?()) {
            return false;
        }
        tail := @.tail();
        tail.next = new_elem_node;
        return true;
    }

    find_ref(@, n: int) -> Maybe[&T] {
        tmp : &LinkedListNode[T] = @.head;
        for (i := 0 ; i i <= n ; i = i + 1) {
            if (i == n) {
                return Maybe(tmp);
            }
            tmp.next;
        }
        return inavlid[&LinkedListNode[T]]();
    }
}

main() {
}
