// wilcard operator - take everything from given module
use * from CompileTime

use { Arena, Mem } from Memory
use { Iterable } from Typing

class List<T> : Iterable {
    elems: Mem<T>
    size: int
    capacity: int


    __new := (@, aloc: Arena, capacity: int = 0) {
        @.capacity = capacity
        @.elems = aloc<T>(@.capacity)
        if (not @.elems.valid?()) {
            panic("not enough memory -- expected capacity = \(capacity)")
        }
        @.size = 0
    }

    append := (@, aloc: Arena<T>, el: T) -> bool {
        if (@.size + 1 > @.capacity) {
            @.capacity = @.capacity * 2
            tmp := aloc<T>(@.capacity)
            if (not tmp.valid?()) {
                return false
            }
            for (i : int = 0; i < @.size; i = i + 1) {
                tmp[i] = @.elems(i)
            }
            @.elems = tmp.value()
        }
        @.elems[i] = el
        @.size = @.size + 1
    }
    
    /*
    * this is special function which makes setting the value possible by []
    * works by returning adding elements, the same way how 
    * (valid==(pointer = malloc(10)))
    * this fragment could work in c 
    * or maybe this should return bool, about how operation happen, idk yet
    */
    __set := (n: int, el: T) -> T {
        @._validate_idx(n)
        @.elems[n] = el
    }


    _validate_idx(@, n: int) {
        if (@.size <= n) {
            panic("List size = \(@.size), expected index = \(n)")
        }
    }

    // this is special funcion which makes iteration possile by []
    __get(@, n: int) -> T {
        @._validate_idx(n)
        return @.elems[n]
    }
}